 local Pack=api.Pack
 local Afflictions=api.Afflictions
 local function encounterActors(sourceKind)
  api.injectResolver(function()return 'knight'end)
  local hero=spawnPlayer();hero.humanoid.MaxHealth=10000;hero.humanoid.Health=10000
  local source=storyEnemy(sourceKind or 'Shaman',12,9)
  local front=storyEnemy('Orc',4,9)
  source.patternHistory.count=2
  return hero,source,front
 end
 local function heroHit(hero,enemy,current,resolved)
  api.setClock(current)
  api.damageEnemy(hero,enemy,{hits={},hitCount=0,attackPower=100,direction=Vector3.new(0,0,-1),
   definition={damage=1,posture=0},resolvedSampleAt=resolved},current)
 end
 local function elementalHit(enemy,hero,element,current)
  api.setClock(current)
  api.applyPlayerHit(enemy,hero,{definition={damage=120,blockable=true},hits={},geometryChecked=true,
   pattern={id=enemy.kind..'.1',element=element},origin=enemy.root.Position,direction=Vector3.new(0,0,1),
   impact=hero.root.Position,sequence=enemy.attackSeq,pulse=1,extraRecovery=0},current)
 end
 local function ticks(current)
  api.setClock(current);api.processCombatSamples(current)
 end
 case('depth-ward-finite-budget-and-tether',function()
  local hero,source,front=encounterActors()
  equal(Pack.trySupport(source,0,api.packContext()),true,'support replaces an offensive turn')
  equal(source.attack,nil,'support has no offensive hitbox')
  api.stepEnemy(source,1.8,0)
  equal(front.packWard~=nil,true,'frontline receives the ward')
  local amount=front.packWard.amount;local hp=front.humanoid.Health
  heroHit(hero,front,2)
  equal(front.humanoid.Health,hp,'ward absorbs confirmed weapon damage')
  equal(front.packWard.amount,amount-100,'ward spends one finite amount')
  source.root.Position+=Vector3.new(40,0,0)
  Pack.step(front,2.1,api.packContext())
  equal(front.packWard,nil,'breaking the range tether removes protection')
  heroHit(hero,front,2.2)
  equal(front.humanoid.Health,hp-100,'frontline becomes vulnerable after the tether breaks')
 end)
 case('depth-ward-interrupt-and-punish',function()
  local hero,source,front=encounterActors()
  Pack.trySupport(source,0,api.packContext())
  heroHit(hero,source,.9)
  equal(source.supportCast,nil,'any class basic hit interrupts the support channel')
  equal(front.packWard,nil,'interrupted support cannot award a late ward')
  equal(source.mechanicWeakness.side,'any','interrupt opens a readable punish window')
  local hp=source.humanoid.Health
  heroHit(hero,source,1)
  equal(hp-source.humanoid.Health,125,'punish window increases actual confirmed damage')
  api.stepEnemy(source,1.8,0)
  equal(front.packWard,nil,'channel end time does not replay the interrupted buff')
 end)
 case('depth-support-late-frame-player-hit-wins',function()
  local hero,source,front=encounterActors()
  Pack.trySupport(source,0,api.packContext())
  heroHit(hero,source,1.9,1.75)
  equal(source.supportCast,nil,'server-approved hit before release wins after a short stall')
  api.stepEnemy(source,1.91,0)
  equal(front.packWard,nil,'delayed release cannot overturn the earlier interruption')
 end)
 case('depth-support-cannot-cross-run-or-pause',function()
  local _,source,front=encounterActors()
  front.model:SetAttribute('DeepwoodEncounter','other-run')
  equal(Pack.trySupport(source,0,api.packContext()),false,'different encounter cannot receive support')
  front.model:SetAttribute('DeepwoodEncounter','qa')
  Pack.trySupport(source,0,api.packContext())
  source.model:SetAttribute('StoryPauseUntil',workspace:GetServerTimeNow()+10)
  api.stepEnemy(source,1.8,0)
  equal(source.supportCast,nil,'story pause cancels channel')
  equal(front.packWard,nil,'paused source grants no ward')
 end)
 case('depth-rally-grants-finite-cadence',function()
  local _,source,front=encounterActors('Warlord')
  Pack.trySupport(source,0,api.packContext());api.stepEnemy(source,1.6,0)
  equal(front.packRally~=nil,true,'commander rallies the finite escort')
  equal(front.humanoid.Health,front.humanoid.MaxHealth,'rally does not heal or create an enemy')
  Pack.cancel(source,2,api.packContext())
  equal(front.packRally,nil,'interrupting or removing commander breaks rally links')
 end)
 case('depth-shared-target-attack-budget',function()
  local hero,first,second=encounterActors('Goblin')
  first.root.Position=origin+Vector3.new(0,0,-4)
  first.model:SetAttribute('StoryDifficulty','Easy');second.model:SetAttribute('StoryDifficulty','Easy')
  api.beginEnemyAttack(first,hero,0)
  api.beginEnemyAttack(second,hero,.3)
  equal(first.attack~=nil,true,'first attack owns the response window')
  equal(second.attack,nil,'Easy does not stack another attack on the same hero')
  second.model:SetAttribute('StoryDifficulty','Hard')
  api.beginEnemyAttack(second,hero,.3)
  equal(second.attack~=nil,true,'Hard permits two readable independent threats')
 end)
 case('depth-rear-weakness-is-directional',function()
  local hero,source=encounterActors('KingOgre')
  Pack.expose(source,0,2,'rear',Vector3.new(0,0,1),function()end)
  local hp=source.humanoid.Health;heroHit(hero,source,.1)
  equal(hp-source.humanoid.Health,100,'front does not claim rear weakness bonus')
  hero.root.Position=source.root.Position+Vector3.new(0,0,-4)
  hp=source.humanoid.Health;heroHit(hero,source,.2)
  equal(hp-source.humanoid.Health,125,'rear positioning earns the punish bonus')
  Pack.step(source,2.1,api.packContext());hp=source.humanoid.Health;heroHit(hero,source,2.2)
  equal(hp-source.humanoid.Health,100,'weakness window expires')
 end)
 case('depth-burn-budget-without-repeat-hitstun',function()
  local hero,source=encounterActors('VolcanoShaman')
  elementalHit(source,hero,'fire',0)
  equal(10000-hero.humanoid.Health,90,'direct hit reserves a bounded burn share')
  equal(Afflictions.count(),1,'confirmed health loss creates one effect')
  hero.mode='Idle';hero.queued={action='Attack',eligibleAt=9,expires=10}
  local queued=hero.queued
  ticks(.6);ticks(1.2)
  equal(10000-hero.humanoid.Health,120,'direct plus burn retain the original raw budget without armor')
  equal(hero.mode,'Idle','burn cannot repeatedly stun the hero')
  equal(hero.queued,queued,'burn does not cancel queued input')
 end)
 case('depth-protected-contact-has-no-elemental-status',function()
  local hero,source=encounterActors('VolcanoShaman')
  hero.branchShield={amount=1000,expires=10};elementalHit(source,hero,'fire',0)
  equal(Afflictions.count(),0,'fully absorbed contact creates no burn')
  equal(hero.character:GetAttribute('K0EnemyBurnUntil'),nil,'fully absorbed contact has no burn presentation')
 end)
 case('depth-elemental-slow-recovers',function()
  local hero,source=encounterActors('IceElf')
  elementalHit(source,hero,'frost',0);hero.mode='Idle'
  api.stepPlayer(hero,.1,0,true)
  near(hero.humanoid.WalkSpeed,api.Config.WalkSpeed*.8,'confirmed frost applies bounded movement slow')
  ticks(1.5);api.stepPlayer(hero,1.5,0,true)
  equal(hero.humanoid.WalkSpeed,api.Config.WalkSpeed,'expired chill restores current movement state')
 end)
 case('depth-venom-cancels-on-source-return',function()
  local hero,source=encounterActors('VenomcoilKing')
  elementalHit(source,hero,'venom',0);local hp=hero.humanoid.Health
  api.setStoryTargetValidator(function()return false end)
  api.stepEnemy(source,.1,0)
  equal(Afflictions.count(),0,'leash or target loss clears source effects')
  api.setStoryTargetValidator(function()return true end);ticks(.6);ticks(1.2)
  equal(hero.humanoid.Health,hp,'returning source leaves no delayed venom damage')
 end)

 case('depth-target-commitment-and-reselection',function()
  local hero,source=encounterActors()
  local second=spawnPlayer()
  hero.root.Position=source.root.Position+Vector3.new(0,0,5)
  second.root.Position=source.root.Position+Vector3.new(0,0,4)
  source.target=hero
  equal(api.closestTarget(source,0),hero,'small nearest-distance changes do not cause target flicker')
  hero.root.Position=source.root.Position+Vector3.new(0,0,30)
  equal(api.closestTarget(source,.1),second,'a clearly better valid target can be selected')
 end)
 case('depth-shadow-weakness-affects-confirmed-output',function()
  local hero,source,front=encounterActors('DeathKnight')
  elementalHit(source,hero,'shadow',0);hero.mode='Idle'
  local hp=front.humanoid.Health;heroHit(hero,front,.1)
  equal(hp-front.humanoid.Health,85,'shadow curse reduces actual outgoing damage without MP dependence')
  ticks(1.6);hp=front.humanoid.Health;heroHit(hero,front,1.7)
  equal(hp-front.humanoid.Health,100,'outgoing damage recovers after the bounded curse')
 end)
