-- Frozen TD combat crystal throne. Generated by tools/snapshot-td-crystal-throne.py.
local VisualFactoryMap = {}
local function newPart(name,size,color,cf,material)
 local p=Instance.new('Part');p.Name=name;p.Size=size;p.Color=color;p.CFrame=cf
 p.Material=material or Enum.Material.Plastic;p.Anchored=true;p.CanCollide=false;return p
end
local function ornament(folder: Instance, name: string, size: Vector3, color: Color3, cf: CFrame, material: Enum.Material): Part
	local part = newPart(name, size, color, cf, material)
	part.CanCollide = false
	part.CanTouch = false
	part.CanQuery = false
	part.CastShadow = material ~= Enum.Material.Neon and size.Y > 1
	part:SetAttribute("MapConcept", true)
	part.Parent = folder
	return part
end

local function facing(position: Vector3, direction: Vector3): CFrame
	local flat = Vector3.new(direction.X, 0, direction.Z)
	if flat.Magnitude < 0.001 then flat = Vector3.new(0, 0, 1) end
	return CFrame.new(position.X, 0, position.Z) * CFrame.Angles(0, math.atan2(flat.X, flat.Z), 0)
end

-- Four corner wedges meet at one apex. Their two sloped faces produce a
-- genuine pointed silhouette from the front AND side, without external assets.
-- The engine corner-wedge apex is local (+X, +Y, -Z).
local function crystal(folder: Instance, name: string, base: CFrame, width: number, height: number, color: Color3): Part
	local pointHeight = math.min(height * 0.38, width * 1.7)
	local bodyHeight = height - pointHeight
	local body = ornament(folder, name, Vector3.new(width, bodyHeight, width), color,
		base * CFrame.new(0, bodyHeight / 2, 0), Enum.Material.SmoothPlastic)
	game:GetService("CollectionService"):AddTag(body, "ThroneCrystal")
	for index = 1, 4 do
		local turn = CFrame.Angles(0, (index - 1) * math.pi / 2, 0)
		local tip = ornament(folder, name .. "Tip" .. index, Vector3.new(width / 2, pointHeight, width / 2),
			color:Lerp(Color3.fromRGB(255, 231, 250), (index % 3) * 0.19),
			base * CFrame.new(0, bodyHeight + pointHeight / 2, 0) * turn * CFrame.new(-width / 4, 0, width / 4), Enum.Material.SmoothPlastic)
		tip.Shape = Enum.PartType.CornerWedge
		game:GetService("CollectionService"):AddTag(tip, "ThroneCrystal")
	end
	local facet = ornament(folder, name .. "Facet", Vector3.new(width * 0.15, bodyHeight * 0.88, 0.025),
		Color3.fromRGB(255, 190, 238), base * CFrame.new(-width * 0.34, bodyHeight * 0.53, width / 2 + 0.04), Enum.Material.Neon)
	game:GetService("CollectionService"):AddTag(facet, "ThroneCrystal")
	return body
end

-- A seated crystal throne on masonry steps, facing the incoming path.
function VisualFactoryMap.buildThrone(folder: Instance, endPos: Vector3, faceDir: Vector3)
	local base = facing(endPos, faceDir)
	local stoneDark = Color3.fromRGB(91, 80, 88)
	local stoneMid = Color3.fromRGB(125, 110, 117)
	local pink = Color3.fromRGB(224, 66, 160)
	local pale = Color3.fromRGB(249, 124, 204)
	local function place(name: string, size: Vector3, color: Color3, x: number, y: number, z: number, material: Enum.Material): Part
		local part = ornament(folder, name, size, color, base * CFrame.new(x, y, z), material)
		if material ~= Enum.Material.Slate and name ~= "ThroneLamp" then
			game:GetService("CollectionService"):AddTag(part, "ThroneCrystal")
		end
		return part
	end
	place("ThroneTier1", Vector3.new(11, 0.7, 10), stoneDark, 0, 0.4, 0, Enum.Material.Slate)
	place("ThroneTier2", Vector3.new(9.6, 0.7, 7.7), stoneMid, 0, 1.1, -0.45, Enum.Material.Slate)
	place("ThroneDais", Vector3.new(7.5, 0.65, 5.6), stoneDark, 0, 1.75, -0.8, Enum.Material.Slate)
	for row = 1, 2 do
		for column = 1, 4 do
			place("ThronePaving", Vector3.new(2.23, 0.14, 1.72), stoneMid:Lerp(stoneDark, (column + row) % 3 * 0.12),
				(column - 2.5) * 2.29, 2.13, (row - 1.5) * 1.8 - 0.8, Enum.Material.Slate)
		end
	end
	for step = 1, 3 do
		place("ThroneStair" .. step, Vector3.new(4.8, 0.32, 0.95), stoneMid,
			0, 0.84 + step * 0.4, 4.6 - step * 0.74, Enum.Material.Slate)
	end
	place("ThroneSeatSupport", Vector3.new(3.2, 0.75, 2.6), pink, 0, 2.55, 0.25, Enum.Material.SmoothPlastic)
	place("ThroneSeat", Vector3.new(3.65, 0.48, 3.2), pale, 0, 3.16, 0.45, Enum.Material.SmoothPlastic)
	place("ThroneSeatTrim", Vector3.new(3.7, 0.09, 0.08), Color3.fromRGB(255, 205, 239), 0, 3.39, 2.07, Enum.Material.Neon)
	local backs = { { 0, 1.48, 8.7, 0 }, { -1.35, 1.16, 7.1, 7 }, { 1.35, 1.16, 7.1, -7 }, { -2.55, 0.9, 5.4, 13 }, { 2.55, 0.9, 5.4, -13 } }
	for index, def in ipairs(backs) do
		local name = "ThroneBack" .. index
		if index == 1 then name = "ThroneCrown" end
		crystal(folder, name, base * CFrame.new(def[1], 2.1, -1.8) * CFrame.Angles(0, math.pi / 4, math.rad(def[4])),
			def[2], def[3], pink:Lerp(pale, index % 3 * 0.22))
	end
	for _, side in ipairs({ -1, 1 }) do
		local tag = "L"
		if side > 0 then tag = "R" end
		place("ThroneArm" .. tag, Vector3.new(0.82, 1.4, 3.25), pink, side * 2.35, 3.1, 0.45, Enum.Material.SmoothPlastic)
		place("ThroneArmCap" .. tag, Vector3.new(1.04, 0.26, 3.5), pale, side * 2.35, 3.92, 0.45, Enum.Material.SmoothPlastic)
	end
	local shards = { { -4.1, 2.4, 0.73, 2.7 }, { 4.1, 2.4, 0.86, 3.15 }, { -4.15, -2.65, 0.75, 2.4 }, { 4.15, -2.65, 0.7, 2.7 } }
	for index, def in ipairs(shards) do
		crystal(folder, "ThroneShard" .. index,
			base * CFrame.new(def[1], 1.3, def[2]) * CFrame.Angles(0, math.pi / 4, -def[1] * 0.035), def[3], def[4], pale)
	end
	-- Stone shoulders and royal hangings make the crystal seat read as a
	-- defended shrine. Stay within the established dais footprint for rally safety.
	for _,side in {-1,1} do
		for course=1,4 do
			place("ThroneShrinePier",Vector3.new(1.15,1.25,1.65),stoneMid:Lerp(stoneDark,(course%2)*0.18),side*4.15,2.3+course*1.2,-2.8,Enum.Material.Slate)
		end
		place("ThroneShrineCapital",Vector3.new(1.7,0.5,2),stoneMid,side*4.15,7.7,-2.8,Enum.Material.Slate)
		-- Use ornament directly: cloth and gold are not animated crystal surfaces.
		ornament(folder,"ThroneRoyalHanging",Vector3.new(1.2,3,0.12),Color3.fromRGB(35,77,149),base*CFrame.new(side*4.15,5.1,-1.91),Enum.Material.Fabric)
		ornament(folder,"ThroneHangingGold",Vector3.new(1.35,0.16,0.16),Color3.fromRGB(212,162,66),base*CFrame.new(side*4.15,6.65,-1.85),Enum.Material.Metal)
	end

	local lamp = place("ThroneLamp", Vector3.new(0.5, 0.5, 0.5), pink, 0, 8.5, 0, Enum.Material.SmoothPlastic)
	lamp.Transparency = 1
	local light = Instance.new("PointLight")
	light.Color = pink
	light.Range = 12
	light.Brightness = 0.55
	light.Parent = lamp
	local sparks = Instance.new("ParticleEmitter")
	sparks.Color = ColorSequence.new(pale)
	sparks.Transparency = NumberSequence.new(0.1, 1)
	sparks.Size = NumberSequence.new(0.3, 0)
	sparks.Lifetime = NumberRange.new(1.2, 2.0)
	sparks.Rate = 10
	sparks.Speed = NumberRange.new(2, 5)
	sparks.EmissionDirection = Enum.NormalId.Top
	sparks.SpreadAngle = Vector2.new(30, 30)
	sparks.LightEmission = 1
	sparks.Parent = lamp
end


local G = {}
function G.build(parent,origin,scale)
 local model=Instance.new('Model');model.Name='TDCrystalThrone'
 VisualFactoryMap.buildThrone(model,Vector3.zero,Vector3.new(0,0,1))
 model.WorldPivot=CFrame.identity
 model:ScaleTo(scale or 1)
 model:PivotTo(CFrame.new(origin))
 model:SetAttribute('TDSourceScale',scale or 1)
 model.Parent=parent
 return model
end
return G
