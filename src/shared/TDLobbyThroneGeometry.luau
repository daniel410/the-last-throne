-- Frozen from TD native lobby sources; generated by tools/snapshot-td-lobby-throne.py.
-- Keep geometry in original TD coordinates. The RPG adapter translates it only.
local G = {}
function G.build(throne, origin)
 local gold = Color3.fromRGB(239,191,84)
 local dark = Color3.fromRGB(110,122,143)
 local function piece(parent, name, size, color, x, y, z, material, solid)
  local p=Instance.new('Part');p.Name=name;p.Size=size;p.CFrame=CFrame.new(origin+Vector3.new(x,y,z))
  p.Color=color;p.Material=material or Enum.Material.Slate
  if color==gold then p.Material=Enum.Material.Metal;p.Color=Color3.fromRGB(240,175,50);p.Reflectance=.18;p:SetAttribute('TDLobbyMetalRole','Gold') end
  p.Anchored=true;p.CanCollide=solid==true;p.CanQuery=solid==true;p.CanTouch=false
  p.TopSurface=Enum.SurfaceType.Smooth;p.BottomSurface=Enum.SurfaceType.Smooth
  p:SetAttribute('TDSourceGeometry',true);p.Parent=parent;return p
 end
	local function beam(parent: Instance, name: string, a: Vector3, b: Vector3, width: number, depth: number, color: Color3)
		local middle = (a + b) / 2
		local part = piece(parent, name, Vector3.new(width, depth, (b-a).Magnitude + .2), color, middle.X, middle.Y, middle.Z, Enum.Material.Marble)
		part.CFrame = CFrame.lookAt(origin + middle, origin + b)
		return part
	end
	local function arch(parent: Instance, name: string, x: number, bottom: number, z: number, halfWidth: number, rise: number, depth: number, color: Color3, pointed: boolean?)
		for index = 0, 11 do
			local function point(t: number): Vector3
				local theta = math.pi * t
				local height = math.sin(theta) * rise
				if pointed then height = (1 - math.abs(math.cos(theta))) ^ .65 * rise end
				return Vector3.new(x + math.cos(theta) * halfWidth, bottom + height, z)
			end
			beam(parent, name, point(index / 12), point((index + 1) / 12), 3, depth, color)
		end
	end
	local function crest(parent: Instance, x: number, y: number, z: number, scale: number)
		piece(parent, "CrownBand", Vector3.new(8*scale, 1.2*scale, .35), gold, x, y, z, Enum.Material.Metal)
		for index = -1, 1 do
			local crown = piece(parent, "CrownPoint", Vector3.new(2*scale, (if index == 0 then 5 else 3.7)*scale, .35), gold, x+index*2.7*scale, y+2*scale, z, Enum.Material.Metal)
			crown.CFrame *= CFrame.Angles(0, 0, math.rad(-index*20))
		end
	end

 local forms={arch=arch,crest=crest}
	piece(throne, "ThroneDais", Vector3.new(22, 1.8, 20), dark, 0, 17.5, -116, nil, true)
	-- The reference landmark is a gold royal chair, distinct from the combat crystal.
	piece(throne,"RoyalThroneSeat",Vector3.new(12,2,8),gold,0,22,-116,Enum.Material.Metal)
	piece(throne,"RoyalThroneCushion",Vector3.new(9,1,6),Color3.fromRGB(37,62,109),0,23.5,-115.5,Enum.Material.Fabric)
	piece(throne,"RoyalThroneBack",Vector3.new(11,21,2),gold,0,31,-120,Enum.Material.Metal)
	piece(throne,"RoyalThroneBackVelvet",Vector3.new(7,16,2.2),Color3.fromRGB(37,62,109),0,31,-119.6,Enum.Material.Fabric)
	forms.arch(throne,"ThroneChairPointedCrown",0,39,-119,6,8,2,gold,true)
	forms.crest(throne,0,36,-118,0.6)
	for _,side in {-1,1} do
		piece(throne,"RoyalThroneArm",Vector3.new(2,2,10),gold,side*6,25,-115,Enum.Material.Metal)
		piece(throne,"RoyalThroneLeg",Vector3.new(2,6,2),gold,side*5,20,-113,Enum.Material.Metal)
		piece(throne,"RoyalThroneFinial",Vector3.new(1.2,26,1.2),gold,side*6,33,-120,Enum.Material.Metal)
	end
end
return G
