local w=workspace:WaitForChild('DawnspireLobbyPrototype');local checks=0;local function check(v,m) assert(v,m);checks+=1 end;check(w.Ground.Size==Vector3.new(200,4,200),'floor');check(w.Spawn.Position==Vector3.new(0,96.1,536),'spawn');local shop=w:WaitForChild('DawnspireItemShop');local forge=w:WaitForChild('DawnspireWeaponMerchant');local mira=w:WaitForChild('DawnspireResidents'):WaitForChild('Mira');check(shop.Counter.Position==Vector3.new(75,97.5,518),'shop at forge side');check(mira:GetPivot().Position==Vector3.new(75,96,523),'Mira follows counter');local prompt=mira:FindFirstChildWhichIsA('ProximityPrompt',true);check(prompt and prompt.KeyboardKeyCode==Enum.KeyCode.F and prompt.MaxActivationDistance==10,'prompt retained');local cf,sz=forge:GetBoundingBox();check(shop.Canopy.Position.X-shop.Canopy.Size.X/2>cf.Position.X+sz.X/2,'no facility overlap');check(w.SafetyBounds.East.Position.X==98 and w.CitadelWalls.EastWall.Position.X==96,'east boundaries expanded');local params=RaycastParams.new();params.FilterType=Enum.RaycastFilterType.Include;params.FilterDescendantsInstances={w};params.RespectCanCollide=true;for x=0,75,5 do local p=Vector3.new(x,100,535);check(workspace:Raycast(p,Vector3.new(0,-12,0),params)~=nil,'ground under shop path');check(workspace:Raycast(p,Vector3.new(5,0,0),params)==nil,'open path') end;for z=523,535,2 do local p=Vector3.new(75,100,z);check(workspace:Raycast(p,Vector3.new(0,-12,0),params)~=nil,'shop approach grounded');check(workspace:Raycast(p,Vector3.new(0,0,2),params)==nil,'shop approach clear') end;check(shop.Sign:FindFirstChild('FacilitySign').Title.Text=='ITEM SHOP','English sign');return {checks=checks,shop=tostring(shop.Counter.Position),mira=tostring(mira:GetPivot().Position),forge=tostring(cf.Position),floor=tostring(w.Ground.Size)}
